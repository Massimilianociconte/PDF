# Environment variables
# Copy this file to .env and modify as needed

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ADMIN_USERNAME=admin
# ADMIN_PASSWORD must be a valid bcrypt hash.
# Default hash for "changeme123":
ADMIN_PASSWORD=$2b$12$Q/g6qpkP9RQKbzw.7s/kc.0RMDghKi1LdEc.6c0nmIUQTOFvW5hPu
