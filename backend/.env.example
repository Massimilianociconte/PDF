# Environment variables for PDF Manipulator Backend

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ADMIN_USERNAME=admin
# ADMIN_PASSWORD must be a valid bcrypt hash.
# Default hash for "changeme123":
ADMIN_PASSWORD=$2b$12$Q/g6qpkP9RQKbzw.7s/kc.0RMDghKi1LdEc.6c0nmIUQTOFvW5hPu

# File storage
UPLOAD_DIR=/tmp/pdf_uploads
MAX_FILE_SIZE=104857600

# Debug mode (set to false in production)
DEBUG=false
